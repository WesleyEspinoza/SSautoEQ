<Window x:Class="SteelSeriesAutoEq.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SteelSeries Auto EQ"
        Height="620" Width="720"
        MinHeight="520" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#FF121216"
        ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="SteelSeries Auto EQ"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="#FFFF7A3D"
                       VerticalAlignment="Center"/>

            <Border Grid.Column="1"
                    Background="#FF1E1E24"
                    BorderBrush="#FF3A3A44"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    MaxWidth="320">
                <StackPanel>
                    <TextBlock Text="ACTIVE PROFILE"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#FF8A8A96"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="ActiveProfileText"
                               Text="—"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FFFF7A3D"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <CheckBox x:Name="AutoSwitchCheck"
                      Content="Enable auto switching"
                      Foreground="#FFE8E8EC"
                      Margin="0,0,0,8"/>
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Default profile"
                           Foreground="#FFB0B0B8"
                           VerticalAlignment="Center"
                           Width="140"/>
                <ComboBox x:Name="DefaultProfileCombo"
                          MinWidth="300"
                          HorizontalAlignment="Left"
                          Background="#FF1E1E24"
                          Foreground="Black"
                          BorderBrush="#FF3A3A44"
                          DisplayMemberPath="Name"/>
            </DockPanel>
            <TextBlock Text="On focus change: use the config assigned to the process, otherwise the default."
                       Foreground="#FF6A6A74"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="#FF171720"
                BorderBrush="#FF3A3A44"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="PROCESS IN FOCUS"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#FF8A8A96"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="FocusProcessText"
                           Text="—"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#FFE8E8EC"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="FocusWindowText"
                           Text=""
                           FontSize="12"
                           Foreground="#FF8A8A96"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"/>
                <DockPanel>
                    <Button x:Name="AssignButton"
                            DockPanel.Dock="Right"
                            Content="Assign to process"
                            Width="150" Height="30"
                            Margin="8,0,0,0"
                            Click="Assign_Click"/>
                    <ComboBox x:Name="AssignProfileCombo"
                              Background="#FF1E1E24"
                              Foreground="Black"
                              BorderBrush="#FF3A3A44"
                              DisplayMemberPath="Name"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="Process assignments"
                           Foreground="#FFE8E8EC"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Content="Remove selected"
                        HorizontalAlignment="Right"
                        Width="130" Height="26"
                        Click="RemoveAssignment_Click"/>
            </Grid>
            <ListView x:Name="AssignmentsList"
                      Background="#FF1A1A20"
                      Foreground="#FFE8E8EC"
                      BorderBrush="#FF3A3A44">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Process" Width="260" DisplayMemberBinding="{Binding Executable}"/>
                        <GridViewColumn Header="Profile" Width="360" DisplayMemberBinding="{Binding ProfileName}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       Foreground="#FF8A8A96"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       TextWrapping="Wrap"
                       MaxWidth="300"/>
            <Button Content="Refresh Profiles"
                    Width="130" Height="30" Margin="0,0,8,0"
                    Click="Refresh_Click"/>
            <Button Content="Save"
                    Width="90" Height="30" Margin="0,0,8,0"
                    Click="Save_Click"/>
            <Button Content="Close"
                    Width="90" Height="30"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
